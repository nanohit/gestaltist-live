# Хранилище контента (Turso / libSQL). Без него сайт отдаёт
# вшитый снапшот src/lib/content.snapshot.json в режиме "только чтение".
TURSO_DB_URL=libsql://<имя-базы>.turso.io
TURSO_DB_AUTH_TOKEN=<токен>

# Публикация content.json в ветку content для jsDelivr (право записи в репозиторий).
GITHUB_CONTENT_TOKEN=<токен-github>
# Секрет 32+ символа: после сохранения загрузчик на Vercel обновляется сразу.
ISR_BYPASS_TOKEN=<случайная-строка>

# Доступ в админку. Если не задать — используются admin / 123456789.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=<надёжный-пароль>
